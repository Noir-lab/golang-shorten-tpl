{
    "swagger": "2.0",
    "info": {
        "description": "Сервис сокращения URL",
        "title": "URL Shortener API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/": {
            "post": {
                "description": "Принимает оригинальный URL в теле запроса, возвращает короткий URL",
                "consumes": [
                    "text/plain"
                ],
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "shorten"
                ],
                "summary": "Сократить URL",
                "parameters": [
                    {
                        "description": "Оригинальный URL",
                        "name": "url",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Сокращённый URL",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Некорректный запрос",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/{id}": {
            "get": {
                "description": "Редиректит на оригинальный URL по идентификатору",
                "tags": [
                    "shorten"
                ],
                "summary": "Перейти по короткому URL",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Идентификатор короткого URL",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "307": {
                        "description": "Temporary Redirect"
                    },
                    "400": {
                        "description": "URL не найден",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}